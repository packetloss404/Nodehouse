# Nodehouse Environment Configuration
# Copy to .env and fill in your values

# Explicitly permits the insecure SysOp/sysop seed on a fresh local database.
# Production, Docker, and Railway deployments must use NODE_ENV=production instead.
NODE_ENV=development

# Required on the first production boot. Use at least 12 characters.
# Existing databases keep their current SysOp password.
# NODEHOUSE_SYSOP_PASSWORD=replace-with-a-long-random-password

# Railway provides PORT for HTTP. Docker Compose supplies the values below.
# TELNET_PORT always remains a separate internal listener port.
# PORT=8088
# TELNET_PORT=2323
# HOST=0.0.0.0

# Optional database override. Production containers should mount persistent
# storage at /app/data and use /app/data/nodehouse.db. Existing local data/packetbbs.db
# and data/vibebbs.db installs are detected automatically when data/nodehouse.db does not exist.
# NODEHOUSE_DB_PATH=data/nodehouse.db

# Optional comma-separated browser origins in addition to the request Host.
# NODEHOUSE_ALLOWED_ORIGINS=https://bbs.example.com

# Optional public identity used in startup logs and release smoke commands.
# NODEHOUSE_PUBLIC_WEB_URL=https://bbs.example.com
# NODEHOUSE_PUBLIC_TELNET_HOST=bbs.example.com
# NODEHOUSE_PUBLIC_TELNET_PORT=23

# Required for Door 5: Dungeon of the Vibe Lords (AI Dungeon Master)
ANTHROPIC_API_KEY=sk-ant-your-key-here
